{
  "name": "template",
  "description": "Base adapter for repositories adopting the framework.",
  "specRoots": [
    "specs"
  ],
  "typePatterns": [
    {
      "match": "specs/briefs/*.md",
      "type": "brief"
    },
    {
      "match": "specs/features/*.md",
      "type": "feature"
    },
    {
      "match": "specs/architecture/*.md",
      "type": "architecture"
    },
    {
      "match": "specs/implementation/*.md",
      "type": "implementation"
    },
    {
      "match": "specs/validation/*.md",
      "type": "validation"
    }
  ],
  "dependencyAliases": {},
  "relations": {
    "featureDependsOnArchitecture": [],
    "featureDependsOnBrief": [],
    "decisionFeedsArchitecture": []
  }
}
